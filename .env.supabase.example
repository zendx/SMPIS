# Copy this file to .env and replace placeholders privately.
# Supabase Dashboard -> Connect -> Transaction pooler (port 6543).
# Percent-encode reserved characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full"
SUPABASE_URL=https://hijjhdxeiqgrsqphydsn.supabase.co
# Use the legacy service_role JWT from Supabase API Keys. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SECRET
SUPABASE_STORAGE_BUCKET=school-documents
# Optional: Supabase's database root CA PEM, with actual newlines or escaped \n.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DB_POOL_MAX=1
REQUIRE_MFA=true
TRUST_PROXY_HOPS=1
APP_URL=https://YOUR_PROJECT.vercel.app
CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Optional mail service:
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=school@example.com

# Required for administration integration credentials. Keep stable across deployments.
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
