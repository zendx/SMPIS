{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "buildCommand": "npm run build:vercel",
  "functions": {
    "index.js": {
      "includeFiles": "{public/index.html,server/*.sql}"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 2 * * *"
    }
  ]
}
