# Copy to deploy/.env on the server. Never commit actual credentials.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# URL-encode reserved characters in the password below.
DATABASE_URL=postgresql://smpis:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@database:5432/smpis
SMTP_URL=
MAIL_FROM=
# Each school ID maps to its own account secret. No default fallback account.
PAYSTACK_SCHOOL_KEYS_JSON='{}'
PAYSTACK_LIVE_ENABLED=false
