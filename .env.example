PORT=3000
HOST=127.0.0.1
# Supabase is required for development and production. No local storage fallback.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full"
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_SECRET
SUPABASE_STORAGE_BUCKET=school-documents
# Generate once using: node -p "require('crypto').randomBytes(32).toString('hex')"
# Preserve this key across deployments and restores.
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# APP_URL=https://school.example.com
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=school@example.com
# Administrators must enroll MFA by default. Disable only for local evaluation.
# REQUIRE_MFA=false
# FEE_REMINDER_DAYS=7,14,30
# TRUST_PROXY_HOPS=1
# All environments require Supabase PostgreSQL and private document storage.
# For Supabase use .env.supabase.example and run npm run supabase:setup.
# DATABASE_URL=postgresql://.../postgres?sslmode=verify-full
# DB_POOL_MAX=1
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-side-only-secret
# SUPABASE_STORAGE_BUCKET=school-documents
# CRON_SECRET=generate-a-long-random-secret
# Each school uses an explicit Paystack secret; there is no shared fallback.
# PAYSTACK_SCHOOL_KEYS_JSON={"1":"sk_test_REPLACE"}
# PAYSTACK_LIVE_ENABLED=false
